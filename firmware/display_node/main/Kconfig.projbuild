menu "OpenGauge: kijelzőegység"

    choice OG_DISP_BOARD
        prompt "Hardverváltozat (lábkiosztás: board_pins.h)"
        default OG_BOARD_DEVKIT_S3
        config OG_BOARD_DEVKIT_S3
            bool "Asztali teszt: Waveshare ESP32-S3-DEV-KIT (N16R8) + 1,85\" modul a 15 pólusú csatlakozón"
        config OG_BOARD_DISP_REV_A
            bool "Saját NYÁK, Rev. A (ESP32-S3-WROOM-1-N8R8, J2 FPC)"
    endchoice

    choice OG_LCD_INIT
        prompt "ST77916 init-sorozat"
        default OG_LCD_INIT_WAVESHARE_1_85
        help
            A panel gyári regiszterbeállításai (feszültség, gamma, időzítés) paneltípusonként eltérnek.
        config OG_LCD_INIT_WAVESHARE_1_85
            bool "Waveshare 1,85\" (ESP32_Display_Panel tábla)"
        config OG_LCD_INIT_COMPONENT_DEFAULT
            bool "Az esp_lcd_st77916 komponens alapértelmezett táblája"
    endchoice

    config OG_LCD_PCLK_MHZ
        int "QSPI órajel (MHz)"
        range 5 80
        default 20
        help
            20 MHz-ről indulunk; ha a kép hibátlan, 40 MHz-ig emelhető (Q-05).

    config OG_LCD_SWAP_BYTES
        bool "RGB565 bájtcsere (a panel nagy-endián sorrendet vár)"
        default y

    config OG_LCD_BGR
        bool "BGR színsorrend (ha a piros és a kék fel van cserélve)"
        default n

    config OG_LCD_BACKLIGHT_PERCENT
        int "Háttérvilágítás (%)"
        range 0 100
        default 80

endmenu

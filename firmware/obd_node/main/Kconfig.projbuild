menu "OpenGauge: OBD-egység"

    choice OG_OBD_BOARD
        prompt "Hardverváltozat (lábkiosztás: board_pins.h)"
        default OG_BOARD_DEVKIT_C3
        config OG_BOARD_DEVKIT_C3
            bool "Asztali teszt: ESP32-C3 SuperMini + SN65HVD230 CAN-TTL modul"
        config OG_BOARD_OBD_REV_A
            bool "Saját NYÁK, Rev. A (ESP32-C3-WROOM-02 + SN65HVD231)"
    endchoice

    config OG_OBD_TEST_BLE
        bool "BLE-hirdetési teszt (S-13): csak hirdet, CAN és ESP-NOW nélkül"
        default n
        help
            A CAN-oldal és az ESP-NOW nem indul el; a C3 másodpercenként növekvő számlálóval
            hirdet, a kijelzőegység BLE-tesztje (OG_DISP_TEST_BLE) ezt szkenneli.

    config OG_OBD_BLE_BEACON
        bool "BLE-hirdetés a normál működés mellett (koegzisztencia-teszt, H-16)"
        default n
        depends on !OG_OBD_TEST_BLE

    config OG_OBD_POWER_SAVE
        bool "Alvás: busz-forgalom hiányában light sleep, időzített figyelőablakokkal (S-12)"
        default n
        depends on !OG_OBD_TEST_BLE && !OG_OBD_BLE_BEACON

    config OG_OBD_IDLE_TO_SLEEP_S
        int "Ennyi másodperc csend (nincs ECU-munkamenet és busz-forgalom) után alszik el"
        range 3 600
        default 20
        depends on OG_OBD_POWER_SAVE

    config OG_OBD_SLEEP_GRACE_S
        int "Indulás után ennyi másodpercig nem alszik el (programozás és hibakeresés)"
        range 0 600
        default 60
        depends on OG_OBD_POWER_SAVE
        help
            Light sleep után a C3 USB-s soros/JTAG-kapcsolata nem tér vissza (H-33), és a programozás
            sem megy, amíg a lapkát kézzel újra nem indítjuk. A türelmi idő alatt a lapka programozható.

    config OG_OBD_SLEEP_PERIOD_MS
        int "Az alvási szakaszok hossza (ms): az ébredési késleltetés felső korlátja"
        range 100 10000
        default 1000
        depends on OG_OBD_POWER_SAVE

    config OG_OBD_LISTEN_MS
        int "A figyelőablak hossza (ms)"
        range 10 500
        default 60
        depends on OG_OBD_POWER_SAVE

    config OG_BLE_ADV_INTERVAL_MS
        int "BLE hirdetési periódus (ms)"
        range 20 10240
        default 100
        depends on OG_OBD_TEST_BLE || OG_OBD_BLE_BEACON

endmenu
